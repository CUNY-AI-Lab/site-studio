{
  "name": "@site-studio/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/bundle-templates.ts",
    "build": "tsc --noEmit",
    "dev": "wrangler dev --port 8792",
    "predeploy": "bun run --cwd ../frontend build && bun run prebuild",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.59",
    "@ai-sdk/provider": "3.0.14",
    "@cloudflare/ai-chat": "0.9.3",
    "@cloudflare/codemode": "0.5.1",
    "@cuny-ai-lab/cail-client": "3.0.1",
    "@cuny-ai-lab/cail-identity": "5.1.2",
    "@cuny-ai-lab/cail-log": "0.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "0.20.1",
    "ai": "6.0.225",
    "fflate": "0.8.3",
    "hono": "4.12.34",
    "unpdf": "1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260722.1",
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
