    "@cuny-ai-lab/cail-client": "github:CUNY-AI-Lab/cail-client#16da40171381b8bf38543730b45dba484ba01940",
    "@cuny-ai-lab/cail-identity": "github:CUNY-AI-Lab/cail-identity#00419a9409680716a04e514068ba2b128ce7afa7",
    "@cuny-ai-lab/cail-log": "github:CUNY-AI-Lab/cail-log#75e0dda3068794ae1543e1e2bb98c9c920bb848f",
    "agents": "0.17.4",
    "ai": "6.0.225",
    "fflate": "0.8.3",
    "hono": "4.12.30",
    "unpdf": "1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260713.1",
