{
  "name": "@site-studio/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/bundle-templates.ts",
    "build": "tsc --noEmit",
    "dev": "wrangler dev --port 8792",
    "predeploy": "bun run --cwd ../frontend build && bun run prebuild",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.41",
    "@ai-sdk/provider": "3.0.8",
    "@cloudflare/ai-chat": "0.2.5",
    "@cloudflare/codemode": "0.3.1",
    "@cuny-ai-lab/cail-client": "github:CUNY-AI-Lab/cail-client#2d51745",
    "@cuny-ai-lab/cail-identity": "github:CUNY-AI-Lab/cail-identity",
    "@cuny-ai-lab/cail-log": "github:CUNY-AI-Lab/cail-log#95e028a",
    "agents": "0.8.4",
    "ai": "6.0.138",
    "fflate": "0.8.2",
    "hono": "4.12.9",
    "unpdf": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260627.1",
    "typescript": "5.9.3",
    "vitest": "3.2.6",
    "wrangler": "4.105.0"
  }
}
