{
  "name": "@site-studio/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/bundle-templates.ts",
    "build": "tsc --noEmit",
    "dev": "bun run prebuild && wrangler dev --port 8792",
    "predeploy": "PUBLIC_BASE_PATH=/site-studio bun run --cwd ../frontend build && bun run prebuild",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:chat-boundary": "node --experimental-loader ./scripts/chat-runtime-contract-loader.mjs ./scripts/chat-runtime-contract.mjs",
    "test:preview-boundary": "bun scripts/preview-route-contract.mjs",
    "test:watch": "vitest",
    "check": "bun run prebuild && vitest run && bun run test:chat-boundary && bun run test:preview-boundary && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.59",
    "@ai-sdk/provider": "3.0.14",
    "@cloudflare/ai-chat": "0.9.3",
    "@cloudflare/codemode": "0.5.1",
    "@cuny-ai-lab/cail-client": "6.0.0",
    "@cuny-ai-lab/cail-identity": "5.2.5",
    "@cuny-ai-lab/cail-log": "0.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "0.20.1",
    "ai": "6.0.225",
    "es-module-lexer": "2.3.1",
    "fflate": "0.8.3",
    "hono": "4.13.1",
    "unpdf": "1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260722.1",
    "htmlrewriter": "0.0.13",
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
