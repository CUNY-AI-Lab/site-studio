{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-studio-app",
  "account_id": "0c7ef775c8a1aa3f6b5bc0d2ae56167b",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_BUILDER_AGENT",
        "class_name": "SiteBuilderAgent"
      },
      {
        // SS-3: atomic first-gate for anonymous→subject migration claims. Keyed
        // by idFromName(anonId) so all subjects racing the SAME anon namespace
        // serialize in one DO instance. See agents/migration-coordinator.ts.
        "name": "MIGRATION_COORDINATOR",
        "class_name": "MigrationCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SiteBuilderAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MigrationCoordinator"]
    }
  ],
  "vars": {
    "APP_PUBLIC_DOMAIN": "https://tools.ailab.gc.cuny.edu",
    "PUBLISHED_BASE_URL": "https://tools.cuny.qzz.io",
    // ---- CAIL backbone (see cail-gateway docs/INTEGRATION.md) ----
    // CAIL_API_BASE: the one public base URL of the CAIL model proxy (serves
    // /v1/... model calls and /keys) in the institutional Cloudflare account.
    // Chat calls hit {CAIL_API_BASE}/v1/chat/completions; image
    // generation hits the native {CAIL_API_BASE}/v1/run.
    "CAIL_API_BASE": "https://cail-model-proxy.ailab-452.workers.dev",
    // CAIL_MODEL: Workers AI catalog id. CAIL policy (2026-07-04): Cloudflare
    // models only — any override must also be a `@cf/...` id. Default is the
    // agentic-coding flagship; `@cf/openai/gpt-oss-120b` is the cheaper fallback.
    "CAIL_MODEL": "@cf/zai-org/glm-5.2",
    // CAIL_IMAGE_MODEL: text-to-image Workers AI catalog id (native /v1/run
    // endpoint). CAIL policy: any override must also be `@cf/...`.
    // Default is the FLUX.2 [klein] text-to-image default;
    // `@cf/black-forest-labs/flux-1-schnell` is the cheaper budget alternative.
    "CAIL_IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    // CAIL_IMAGE_CLASSIFIER: vision model backing the REQUIRED image moderation
    // gate — Workers AI has no dedicated NSFW classifier, so we vision-screen
    // every generated image before saving it. `@cf/...` only;
    // `@cf/meta/llama-3.2-11b-vision-instruct` is the fallback vision model.
    "CAIL_IMAGE_CLASSIFIER": "@cf/google/gemma-4-26b-a4b-it",
    // CAIL_REQUIRE_IDENTITY: "false" during pre-SSO rollout (anonymous sessions
    // still allowed). Flip to "true" in lockstep with the gateway's
    // CAIL_SSO_MODE=enforce so the workers.dev URL is not an anonymous bypass.
    "CAIL_REQUIRE_IDENTITY": "false",
    // Script-readable anti-CSRF delivery cookie scope. This deployment shares
    // its origin with sibling tools and untrusted /sites/ content, so runtime
    // validation requires this exact path and rejects a root-scoped cookie.
    "CSRF_COOKIE_PATH": "/site-studio"
  },
  // ---- Secrets (never real values here) ----
  // Set via `wrangler secret put` (ops-managed; cail-gateway push-secrets.sh):
  //   CAIL_IDENTITY_JWT_SECRET  shared HS256 secret to verify X-CAIL-Identity-JWT
  //   CAIL_IDENTITY_JWKS        JSON public JWKS to verify authoritative RS256
  //                             X-CAIL-Identity-JWT-V2 tokens (aud cail:site-studio)
  // Site Studio holds NO provider API keys — the CAIL model proxy attaches them.
  // (OPENROUTER_API_KEY was removed on 2026-07-03.)
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "assets": {
    "directory": "../frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      // NOTE: the "site-studio" R2 bucket is shared with agent-studio's branch
      // (flagged upstream). Do not rename or repoint it here without coordinating
      // that migration; ownership is keyed by CAIL subject prefixes within it.
      "binding": "SITE_STUDIO_BUCKET",
      "bucket_name": "site-studio"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "76d51fbed2074ae6a91c21c70f810a25",
      "preview_id": "76d51fbed2074ae6a91c21c70f810a25"
    }
  ]
}
