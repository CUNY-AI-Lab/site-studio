{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-studio-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_BUILDER_AGENT",
        "class_name": "SiteBuilderAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SiteBuilderAgent"]
    }
  ],
  "vars": {
    "APP_PUBLIC_DOMAIN": "https://tools.ailab.gc.cuny.edu",
    "LEGACY_PUBLIC_DOMAIN": "https://tools.cuny.qzz.io",
    "R2_PUBLIC_DOMAIN": "https://tools.cuny.qzz.io",
    "OPENROUTER_MODEL": "anthropic/claude-sonnet-4.6"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "assets": {
    "directory": "../frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "SITE_STUDIO_BUCKET",
      "bucket_name": "site-studio"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "76d51fbed2074ae6a91c21c70f810a25",
      "preview_id": "76d51fbed2074ae6a91c21c70f810a25"
    }
  ]
}
