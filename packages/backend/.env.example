# Server Configuration
PORT=3001

# Projects Directory (where user sites are stored)
# If not set, defaults to ./projects
PROJECTS_DIR=

# API Configuration
# Option 1: Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Option 2: AWS Bedrock (recommended for production)
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-bedrock-access-key
# AWS_SECRET_ACCESS_KEY=your-bedrock-secret-key

# Option 3: Google Vertex AI
# CLAUDE_CODE_USE_VERTEX=1

# Storage Configuration
# Use 'filesystem' or 'r2' (defaults to 'filesystem' if not set)
STORAGE_TYPE=filesystem

# Cloudflare R2 Configuration (only needed if STORAGE_TYPE=r2)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=site-studio
# Optional: Public domain for published sites
# If not set, will auto-detect from request
# Example: https://tools.cuny.qzz.io
# Published sites will be available at: {R2_PUBLIC_DOMAIN}/sites/{userId}/{project-slug}/
R2_PUBLIC_DOMAIN=

# Auth Configuration
# Modes: anonymous | required
AUTH_MODE=anonymous

# Internal Auth Token (for thumbnail generation and internal services)
# IMPORTANT: Set a strong random token in production, no default allowed
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=

# Public URL for backend (optional; used by some features)
# BACKEND_URL=http://localhost:3001

# SDK Sandbox Configuration
# Enables OS-level sandboxing (Linux bubblewrap) for safe Bash command execution.
# When enabled, agents can run commands like `hugo`, `npm`, etc. in isolated environments.

# Enable sandbox mode (default: false)
AGENT_SANDBOX_ENABLED=false

# Auto-approve Bash commands when sandboxed (default: false)
# When true, Bash/BashOutput/KillShell tools are enabled and run inside sandbox
AGENT_SANDBOX_AUTO_ALLOW_BASH=false

# Allow processes to bind to local ports (default: false)
# Enable for dev servers, build tools that start local servers
AGENT_SANDBOX_ALLOW_LOCAL_BINDING=false
