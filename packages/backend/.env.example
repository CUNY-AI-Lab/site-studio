# Server Configuration
PORT=3001

# Projects Directory (where user sites are stored)
# If not set, defaults to ./projects
PROJECTS_DIR=

# API Configuration
# Option 1: Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Option 2: AWS Bedrock (recommended for production)
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-bedrock-access-key
# AWS_SECRET_ACCESS_KEY=your-bedrock-secret-key

# Option 3: Google Vertex AI
# CLAUDE_CODE_USE_VERTEX=1

# Storage Configuration
# Use 'filesystem' or 'r2' (defaults to 'filesystem' if not set)
STORAGE_TYPE=filesystem

# Cloudflare R2 Configuration (only needed if STORAGE_TYPE=r2)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=site-studio
# Optional: Public domain for published sites
# If not set, will auto-detect from request
# Example: https://tools.cuny.qzz.io
# Published sites will be available at: {R2_PUBLIC_DOMAIN}/sites/{userId}/{project-slug}/
R2_PUBLIC_DOMAIN=

# Auth Configuration
# Modes: anonymous | required
AUTH_MODE=anonymous

# Public URL for backend (optional; used by some features)
# BACKEND_URL=http://localhost:3001
