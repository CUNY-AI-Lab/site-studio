# Server Configuration
PORT=3001

# Projects Directory (where user sites are stored)
# If not set, defaults to ./projects
PROJECTS_DIR=

# API Configuration
# For direct Anthropic API: Set only ANTHROPIC_API_KEY
# For OpenRouter: Set both ANTHROPIC_API_KEY (your OpenRouter key) and ANTHROPIC_BASE_URL
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1

# Storage Configuration
# Use 'filesystem' or 'r2' (defaults to 'filesystem' if not set)
STORAGE_TYPE=filesystem

# Cloudflare R2 Configuration (only needed if STORAGE_TYPE=r2)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=site-studio
# Optional: Public domain for published sites (e.g., sitestudio.com)
R2_PUBLIC_DOMAIN=
