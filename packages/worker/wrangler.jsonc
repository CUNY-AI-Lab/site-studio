{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-studio-publisher",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      // Published paths may contain user-controlled segments. Persist only the
      // publisher's structured template events, never raw-URL invocation logs.
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "workers_dev": true,
  // No zone routes: the public hostname's zone (cuny.qzz.io) lives in the
  // legacy personal Cloudflare account, and Workers routes cannot cross
  // accounts. The legacy personal site-studio-publisher keeps serving
  // tools.cuny.qzz.io/sites/* and /u/* until the zone (or its routing) is
  // migrated — that cutover is a separate, explicitly operator-approved step.
  "vars": {
    "CAIL_LOG_ENV": "production",
    "PUBLIC_DOMAIN": "https://tools.cuny.qzz.io"
  },
  "r2_buckets": [
    {
      "binding": "SITE_STUDIO_BUCKET",
      "bucket_name": "site-studio"
    }
  ]
}
