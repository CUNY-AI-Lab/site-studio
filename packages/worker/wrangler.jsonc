{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site-studio-publisher",
  "account_id": "0c7ef775c8a1aa3f6b5bc0d2ae56167b",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      // Published paths may contain user-controlled segments. Persist only the
      // publisher's structured template events, never raw-URL invocation logs.
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tools.cuny.qzz.io/sites/*",
      "zone_name": "cuny.qzz.io"
    },
    // Canonical published URLs target /u/* on this host. The main app also
    // serves /u/* at tools.ailab.gc.cuny.edu, but that app's custom-domain
    // routing is dashboard-managed and cannot be verified from its wrangler.jsonc.
    {
      "pattern": "tools.cuny.qzz.io/u/*",
      "zone_name": "cuny.qzz.io"
    }
  ],
  "vars": {
    "CAIL_LOG_ENV": "production",
    "PUBLIC_DOMAIN": "https://tools.cuny.qzz.io"
  },
  "r2_buckets": [
    {
      "binding": "SITE_STUDIO_BUCKET",
      "bucket_name": "site-studio"
    }
  ]
}
