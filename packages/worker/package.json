{
  "name": "@site-studio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker for serving published Site Studio projects",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vitest run && tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260627.1",
    "@types/node": "20.19.24",
    "typescript": "5.9.3",
    "vitest": "3.2.6",
    "wrangler": "4.105.0"
  }
}
