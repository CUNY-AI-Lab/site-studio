{
  "name": "@site-studio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker for serving published Site Studio projects",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@cuny-ai-lab/cail-log": "github:CUNY-AI-Lab/cail-log#862067d3ac83d0cde456eb38d3a6bad6df0476e5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260713.1",
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
