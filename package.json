{
  "name": "site-studio",
  "version": "0.1.0",
  "description": "Cloudflare-native AI website builder for academics and researchers",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/frontend build && bun run --cwd packages/app build",
    "dev:app": "bun run --cwd packages/app dev",
    "dev:frontend": "bun run --cwd packages/frontend dev",
    "dev": "bun run --parallel --filter @site-studio/app --filter @site-studio/frontend dev",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "lint": "biome lint . && oxlint .",
    "e2e:install": "playwright install chromium",
    "e2e:install:ci": "playwright install --with-deps chromium",
    "e2e:local": "bun run build && bun scripts/local-browser-e2e.ts",
    "e2e:live": "node scripts/live-product-e2e.mjs",
    "check": "bun run lint && bun run --cwd packages/app check && bun run --cwd packages/frontend check && bun run --cwd packages/frontend build"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "1.62.1",
    "oxlint": "1.79.0",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "cookie": "0.7.2",
    "fast-uri": "3.1.7",
    "sharp": "0.35.2",
    "vite": "8.1.4",
    "qs": "6.16.0",
    "browserslist": "4.28.8"
  },
  "patchedDependencies": {
    "@cloudflare/ai-chat@0.9.3": "patches/@cloudflare%2Fai-chat@0.9.3.patch"
  }
}
