{
  "name": "site-studio",
  "version": "0.1.0",
  "description": "Cloudflare-native AI website builder for academics and researchers",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/frontend build && bun run --cwd packages/app build && bun run --cwd packages/worker build",
    "dev:app": "bun run --cwd packages/app dev",
    "dev:frontend": "bun run --cwd packages/frontend dev",
    "dev": "bun run --parallel --filter @site-studio/app --filter @site-studio/frontend dev",
    "chat:debug": "node ./scripts/project-chat-debug.mjs",
    "trace": "node ./scripts/project-observability.mjs",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "check:dependencies": "node ./scripts/dependency-resolution-gate.mjs",
    "test:dependencies": "node --test scripts/dependency-resolution-gate.test.mjs",
    "lint": "biome lint .",
    "verify:repository": "node ./scripts/verify-repository.mjs",
    "check": "bun run lint && bun run --cwd packages/app check && bun run --cwd packages/worker check && bun run --cwd packages/frontend check && bun run --cwd packages/frontend build"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "semver": "7.8.5",
    "ws": "8.21.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "cookie": "0.7.2",
    "fast-uri": "3.1.5",
    "postcss": "8.5.25",
    "sharp": "0.35.2",
    "vite": "8.1.4"
  }
}
