{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Group CAIL primitive minor/patch bumps into one auto-tested PR.",
      "matchPackageNames": ["/^@cuny-ai-lab//"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "cail-primitives",
      "labels": ["cail-primitives"]
    },
    {
      "description": "A breaking major of a CAIL primitive (e.g. cail-identity 4.x) gets its own reviewable PR — never grouped.",
      "matchPackageNames": ["/^@cuny-ai-lab//"],
      "matchUpdateTypes": ["major"],
      "labels": ["cail-primitives", "cail-primitives-major"]
    }
  ]
}
